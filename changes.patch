+/* Progressive, bounded presentation. Content and workflow controls remain stationary. */
+.presentation-progress{position:fixed;inset:0 0 auto;height:2px;z-index:170;pointer-events:none;contain:strict}
+.presentation-progress>div{height:100%;background:var(--presentation-accent);transform:scaleX(0);transform-origin:left;opacity:0;will-change:transform}
+[data-motion-enhanced=true]{transition:opacity .52s ease,transform .62s cubic-bezier(.22,.61,.36,1)}
+[data-motion-enhanced=true][data-motion-enter=waiting]{opacity:.9;transform:translateY(10px)}
+[data-motion-enhanced=true][data-motion-enter=waiting][data-motion-direction=up]{transform:translateY(-8px)}
+[data-motion-enhanced=true][data-motion-enter=visible],[data-motion-enhanced=true]:focus-within{opacity:1;transform:none}
+[data-motion-stage=true]{transform:perspective(1100px) translate3d(var(--stage-x,0px),var(--stage-y,0px),0) rotateX(var(--stage-rx,0deg)) rotateY(var(--stage-ry,0deg));transform-style:preserve-3d;transform-origin:50% 50%}
+@media(max-width:700px){[data-motion-enhanced=true][data-motion-enter=waiting]{transform:translateY(6px);opacity:.95}}
+@media(prefers-reduced-motion:reduce){.presentation-progress{display:none}[data-motion-enhanced=true],[data-motion-stage=true]{animation:none!important;transition:none!important;transform:none!important;opacity:1!important}}
+
+/* A restrained three-axis evidence sculpture; no motion is applied to saved values. */
+.landing [data-motion-enhanced=true]{animation:none!important}.landing .reveal{opacity:1}
+.evidence-motion{overflow:visible}.motion-sculpture{transform-style:preserve-3d}.motion-floor{opacity:.7}.depth-plane{backdrop-filter:blur(2px)}
+@media(prefers-reduced-motion:no-preference){.motion-sculpture{animation:ledger-evidence-depth 15s cubic-bezier(.45,0,.55,1) infinite!important;will-change:transform}.motion-floor{animation:evidence-shadow 15s ease-in-out infinite}.motion-orbit{animation:orbit-breathe 20s ease-in-out infinite}}
+@keyframes ledger-evidence-depth{0%,100%{transform:translate3d(-3px,2px,-5px) rotateX(-2deg) rotateY(-3deg) rotateZ(-.45deg)}25%{transform:translate3d(1px,-6px,7px) rotateX(1deg) rotateY(1.5deg) rotateZ(.35deg)}50%{transform:translate3d(4px,-3px,12px) rotateX(2deg) rotateY(3deg) rotateZ(.65deg)}75%{transform:translate3d(0,4px,1px) rotateX(-1deg) rotateY(.5deg) rotateZ(-.2deg)}}
