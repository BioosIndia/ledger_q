+html[data-presentation-hidden=true] .motion-sculpture,html[data-presentation-hidden=true] .motion-floor,html[data-presentation-hidden=true] .motion-orbit{animation-play-state:paused!important}
+@media(prefers-reduced-motion:reduce){.motion-sculpture,.motion-floor,.motion-orbit,.motion-signal{animation:none!important;transform:none!important}.landing .reveal{opacity:1!important;transform:none!important}}
+
+/* Clearly visible, reversible landing reveals; existing product design retained. */
+.landing .reveal[data-motion-enhanced=true]{animation:none!important;transition:opacity .65s ease,transform .8s cubic-bezier(.16,1,.3,1)!important;transform-origin:center;will-change:auto}
+.landing .reveal[data-motion-enhanced=true][data-motion-enter=waiting]{opacity:.42!important;transform:translateY(42px) scale(.985)!important}
+.landing .reveal[data-motion-enhanced=true][data-motion-enter=waiting][data-motion-direction=up]{transform:translateY(-38px) scale(.985)!important}
+.landing .reveal[data-motion-enhanced=true][data-motion-enter=visible],.landing .reveal[data-motion-enhanced=true]:focus-within{opacity:1!important;transform:none!important}
+@media(max-width:700px){.landing .reveal[data-motion-enhanced=true][data-motion-enter=waiting]{transform:translateY(27px) scale(.99)!important}.landing .reveal[data-motion-enhanced=true][data-motion-enter=waiting][data-motion-direction=up]{transform:translateY(-25px) scale(.99)!important}}
+@media(prefers-reduced-motion:reduce){.landing .reveal[data-motion-enhanced=true]{opacity:1!important;transform:none!important;transition:none!important}}
+:root[data-lq-motion="reduced"] .landing .reveal[data-motion-enhanced=true]{opacity:1!important;transform:none!important;transition:none!important}
